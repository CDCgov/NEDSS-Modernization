{
    "name": "cypress-cucumber-framework",
    "version": "1.0.0",
    "description": "A demo framework with cypress and cucumber with cucumber html report",
    "scripts": {
        "cypress": "cypress open --config-file cypress.config.mts",
        "cy:open": "cypress open --config-file cypress.config.mts",
        "cy:e2e": "cypress run --config-file cypress.config.mts --spec 'cypress/e2e/**/*.feature'",
        "cy:api": "cypress run --config-file cypress.config.mts --spec cypress/api/**/*.feature",
        "report": "node cucumber-html-report.js",
        "githubReport": "node github-report.js",
        "PublishAllPages": "cd ../../cdc-sandbox && docker compose exec wildfly sh -c './nedssdomain/Nedss/BatchFiles/PublishAllPages.sh superuser'",
        "PHCRImporter": "cd ../../cdc-sandbox && docker compose exec wildfly sh -c './nedssdomain/Nedss/BatchFiles/PHCRImporter.sh superuser'",
        "ELRImporter": "cd ../../cdc-sandbox && docker compose exec wildfly sh -c './nedssdomain/Nedss/BatchFiles/ELRImporter.sh'",
        "typecheck": "tsc -b --noEmit",
        "typecheck:watch": "tsc -b --noEmit --watch",
        "lint": "eslint \"cypress/**/*.{js,jsx,ts,tsx}\"",
        "lint:fix": "eslint \"cypress/**/*.{ts,tsx,js,jsx}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:fix": "npm run format && npm run lint:fix && npm run typecheck"
    },
    "keywords": [
        "cypress",
        "cucumber"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
        "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
        "@dankieu/cypress-sql": "^2.1.8",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.5.0",
        "@testing-library/cypress": "^10.1.3",
        "@types/node": "^22.20.1",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "cypress": "^14.5.4",
        "cypress-xpath": "^2.0.1",
        "eslint": "^10.4.1",
        "eslint-plugin-cypress": "^4.3.0",
        "multiple-cucumber-html-reporter": "^3.6.2",
        "prettier": "^3.9.6",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "overrides": {
        "js-yaml": "4.3.0"
    },
    "cypress-cucumber-preprocessor": {
        "nonGlobalStepDefinitions": false,
        "stepDefinitions": "./cypress/step_definitions/{*,**/*}.{js,ts}",
        "json": {
            "enabled": true,
            "output": "./reports/log.json",
            "formatter": "cucumber-json-formatter.exe"
        },
        "messages": {
            "enabled": true,
            "output": "./reports/messages.ndjson"
        },
        "html": {
            "enabled": true,
            "output": "./reports/cucumber-report.html"
        }
    },
    "dependencies": {
        "badeball": "^20.1.1"
    }
}
